# One-shot Azure deploy config for Relay.
#   cp deploy/deploy.env.example deploy/deploy.env   # then fill the secrets
#   bash deploy/deploy.sh
# deploy/deploy.env is git-ignored — never commit it.

# ---- Azure naming (letters/numbers/dashes, must be globally unique where noted) ----
RG=relay-prod
LOC=centralindia
REG=relayprod              # globally unique (Container Registry)
CAENV=relay-env
TAG=latest

# ---- Cosmos DB (Mongo API) ----
COSMOS_ACCOUNT=relay-cosmos   # globally unique
COSMOS_FREE_TIER=false        # true only if this subscription never used it

# ---- Redis ----
REDIS_NAME=relay-redis

# ---- Storage (lowercase, globally unique) ----
STORAGE_ACCOUNT=relayuploads
STORAGE_CONTAINER=relay

# ---- Firebase Admin (service-account values; PRIVATE_KEY keeps \n literals) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Razorpay (use TEST keys first) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Frontend build args (NEXT_PUBLIC_* are baked into the web image) ----
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- Optional: your domains (leave empty for default FQDNs) ----
WEB_DOMAIN=        # e.g. app.yourdomain.com  (set DNS CNAME first)
GATEWAY_DOMAIN=    # e.g. api.yourdomain.com
